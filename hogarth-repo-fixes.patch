-  function setCameraFrame(vs, dist, lookAt){
-    const a = window.innerWidth/window.innerHeight;
-    camera.left=-vs*a; camera.right=vs*a; camera.top=vs; camera.bottom=-vs;
-    camera.position.set(lookAt.x+dist*ISO_DIR.x, lookAt.y+dist*ISO_DIR.y, lookAt.z+dist*ISO_DIR.z);
-    camera.lookAt(lookAt);
-    camera.updateProjectionMatrix();
-    currentVs = vs; currentDist = dist; currentLookAt = lookAt.clone();
-  }
