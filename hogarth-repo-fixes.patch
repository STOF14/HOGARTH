-  async function handleComicFile(file){
-    if (!COMIC_EXT_RE.test(file.name)){
-      showStatus(`Skipped "${file.name}" — only .cbz/.cbr/.zip/.rar supported`);
-      return;
-    }
-    showStatus(`Extracting "${file.name}"…`);
-    try {
-      const comic = await decodeComicArchive(file);
-      const coverUrl = comic.cache.urlFor(0, comic.pages[0].file);
-      const img = await new Promise((resolve, reject) => {
-        const im = new Image();
-        im.onload = () => resolve(im);
-        im.onerror = () => reject(new Error('Could not decode cover page'));
-        im.src = coverUrl;
-      });
-      const thumb = makeThumbFromImage(img);
-      const dominant = extractDominantColor(thumb);
-      const baseHex = shade(dominant, -0.28);
-      const accentHex = shade(dominant, 0.32);
-      const title = file.name.replace(/\.[^.]+$/, '');
-      showStatus(`"${title}" — ${comic.pages.length} page${comic.pages.length===1?'':'s'}`);
-      placePlot(title, baseHex, accentHex, dominant, thumb, comic);
-    } catch (err){
-      showStatus(`Failed to read "${file.name}": ${err.message}`);
-    }
-  }
